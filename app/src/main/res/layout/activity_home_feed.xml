<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">


    <!-- ========================= -->
    <!-- TOP HEADER -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="@color/white">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CampusConnect"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="@color/app_name"/>

        <TextView
            android:id="@+id/btnNotification"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="🔔"
            android:textSize="23sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>


    <!-- Divider -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E5E5"/>


    <!-- ========================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">


            <!-- ========================= -->
            <!-- CREATE POST -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/btnCreatePost"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:background="#F5F3FA"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="25sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="What's on your mind?"
                    android:textSize="15sp"
                    android:textColor="#777777"/>

            </LinearLayout>


            <!-- Space -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp"/>


            <!-- ========================= -->
            <!-- POST 1 -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/postOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@color/white"
                android:clickable="true"
                android:focusable="true">


                <!-- User -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:text="👤"
                        android:textSize="25sp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Md Mujahidur Rahman"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="CSE • 2 hours ago"
                            android:textSize="13sp"
                            android:textColor="#777777"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- Post Text -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Welcome to CampusConnect! Let's connect, share and grow together."
                    android:textSize="16sp"
                    android:textColor="@color/black"/>


                <!-- Post Image -->

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="12dp"
                    android:src="@drawable/campus"
                    android:scaleType="centerCrop"
                    android:contentDescription="Post Image"/>


                <!-- Counts -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="❤️ 12 Likes"
                        android:textSize="14sp"
                        android:textColor="#555555"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 5 Comments"
                        android:textSize="14sp"
                        android:textColor="#555555"/>

                </LinearLayout>


                <!-- Divider -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"/>


                <!-- Action Buttons -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="♡ Like"
                        android:textSize="14sp"
                        android:textColor="@color/app_name"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="💬 Comment"
                        android:textSize="14sp"
                        android:textColor="@color/app_name"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="↗ Share"
                        android:textSize="14sp"
                        android:textColor="@color/app_name"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ========================= -->
            <!-- SEPARATOR -->
            <!-- ========================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="#F3F3F3"/>


            <!-- ========================= -->
            <!-- POST 2 -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@color/white">


                <!-- User -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:text="👨"
                        android:textSize="25sp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ahmed Rahman"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CSE • 4 hours ago"
                            android:textSize="13sp"
                            android:textColor="#777777"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- Text -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Does anyone have Database Management System notes? Please share if possible."
                    android:textSize="16sp"
                    android:textColor="@color/black"/>


                <!-- Counts -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="❤️ 18 Likes"
                        android:textSize="14sp"
                        android:textColor="#555555"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 7 Comments"
                        android:textSize="14sp"
                        android:textColor="#555555"/>

                </LinearLayout>


                <!-- Divider -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"/>


                <!-- Actions -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="♡ Like"
                        android:textColor="@color/app_name"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="💬 Comment"
                        android:textColor="@color/app_name"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="↗ Share"
                        android:textColor="@color/app_name"/>

                </LinearLayout>

            </LinearLayout>


            <!-- Bottom Space -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="15dp"/>

        </LinearLayout>

    </ScrollView>


    <!-- ========================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/white">


        <!-- HOME -->

        <TextView
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏠\nHome"
            android:textSize="13sp"
            android:textColor="@color/app_name"/>


        <!-- CHAT -->

        <TextView
            android:id="@+id/btnChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="💬\nChat"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:clickable="true"
            android:focusable="true"/>


        <!-- CREATE -->

        <TextView
            android:id="@+id/btnCreate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="＋"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/app_name"
            android:clickable="true"
            android:focusable="true"/>


        <!-- NOTICES -->

        <TextView
            android:id="@+id/btnNotices"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📢\nNotices"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:clickable="true"
            android:focusable="true"/>


        <!-- PROFILE -->

        <TextView
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👤\nProfile"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>