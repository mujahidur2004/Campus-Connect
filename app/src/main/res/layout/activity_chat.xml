<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="15dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="38sp"
            android:textColor="@color/app_name"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="👤"
            android:textSize="25sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ahmed Rahman"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online"
                android:textSize="12sp"
                android:textColor="#4CAF50"/>

        </LinearLayout>

        <TextView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="📞"
            android:textSize="20sp"/>

        <TextView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="⋮"
            android:textSize="25sp"
            android:textColor="@color/black"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"/>

    <!-- Messages -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/messageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Received message -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Can you send the DBMS notes?"
                android:textSize="15sp"
                android:textColor="@color/black"
                android:padding="14dp"
                android:background="#F1EFF5"
                android:layout_margin="8dp"/>

            <!-- Sent message -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sure, uploading now."
                android:textSize="15sp"
                android:textColor="@color/white"
                android:padding="14dp"
                android:background="@color/app_name"
                android:layout_gravity="end"
                android:layout_margin="8dp"/>

            <!-- File -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📄  DBMS_Notes.pdf\n     2.4 MB"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:padding="14dp"
                android:background="#F1EFF5"
                android:layout_margin="8dp"/>

            <!-- Received -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thanks ❤️"
                android:textSize="15sp"
                android:textColor="@color/black"
                android:padding="14dp"
                android:background="#F1EFF5"
                android:layout_margin="8dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- Message Input -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@color/white">

        <TextView
            android:layout_width="40dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="📎"
            android:textSize="20sp"/>

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Type a message..."
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="#777777"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/edittext_background"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="70dp"
            android:layout_height="48dp"
            android:layout_marginStart="5dp"
            android:text="Send"
            android:textColor="@color/white"
            android:backgroundTint="@color/app_name"/>

    </LinearLayout>

</LinearLayout>